{
  "name": "domainatlas",
  "version": "0.2.1",
  "description": "Local business change ledger and workbench for AI-assisted development",
  "type": "module",
  "files": [
    "dist/src",
    "apps/web/dist",
    "skills",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.13.0",
  "bin": {
    "domainatlas": "dist/src/cli.js"
  },
  "scripts": {
    "build": "pnpm build:core && pnpm --filter @domainatlas/web build",
    "build:core": "tsc -p tsconfig.json",
    "dev:web": "pnpm --filter @domainatlas/web dev",
    "ui": "node dist/src/cli.js ui",
    "test": "pnpm run build && node --test dist/tests/*.test.js script/*.test.mjs",
    "release:check": "bash script/release.sh",
    "release": "bash script/release.sh --publish",
    "test:graph": "pnpm run build && DOMAINATLAS_REAL_GRAPH=1 node --test dist/tests/codebase-memory.integration.test.js",
    "domainatlas": "node dist/src/cli.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
