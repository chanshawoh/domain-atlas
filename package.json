{
  "name": "domainatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "bin": {
    "domainatlas": "dist/src/cli.js"
  },
  "scripts": {
    "build": "pnpm build:core && pnpm --filter @domainatlas/web build",
    "build:core": "tsc -p tsconfig.json",
    "dev:web": "pnpm --filter @domainatlas/web dev",
    "ui": "node dist/src/cli.js ui",
    "test": "pnpm run build && node --test dist/tests/*.test.js",
    "test:graph": "pnpm run build && DOMAINATLAS_REAL_GRAPH=1 node --test dist/tests/codebase-memory.integration.test.js",
    "domainatlas": "node dist/src/cli.js"
  },
  "dependencies": {
    "zod": "^4.0.0",
    "fastify": "^5.0.0",
    "@fastify/static": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
